# ============================================================
# Plantilla de variables de entorno — Raillytics Light
# Copiar a .env y rellenar con valores reales:  cp .env.example .env
# El fichero .env NUNCA se sube al repositorio (está en .gitignore)
# ============================================================

# === AEMET — API pública de meteorología ===
# Solicitar clave gratuita en: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# === Snowflake — Data Warehouse (capa Gold) ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=RAILLYTICS
SNOWFLAKE_SCHEMA=GOLD

# === Rutas del Data Lake local ===
DATA_LAKE_PATH=./data

# === Spark en Windows ===
# Hadoop necesita winutils.exe para escribir en disco local (apps L1/L2 y Gold,
# tests de Spark). El Makefile exporta esta variable y los tests la leen de aquí
# si no viene en el entorno (pre-push hook, IDE). En Linux/macOS déjala vacía.
HADOOP_HOME=C:\dev\winutils\hadoop-3.0.0

# === MinIO — Almacenamiento S3-compatible (docker-compose) ===
# Definir un usuario y contraseña propios (no usar valores por defecto)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminadmin
# Puertos en el host (cámbialos si están ocupados, p.ej. Zscaler usa el 9000).
# MINIO_ENDPOINT debe usar el mismo puerto que MINIO_API_PORT.
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=http://localhost:19000
MINIO_BUCKET_BRONZE=raillytics-bronze
MINIO_BUCKET_SILVER=raillytics-silver
MINIO_BUCKET_GOLD=raillytics-gold

# === Postgres — metadatos de Airflow y de Superset (docker-compose) ===
# Un único servidor con una base de datos para cada herramienta; no es el Data Warehouse.
POSTGRES_USER=raillytics
POSTGRES_PASSWORD=raillytics
AIRFLOW_POSTGRES_DB=airflow
SUPERSET_POSTGRES_DB=superset

# === Airflow — Orquestación (docker-compose) ===
# En Linux, evitar problemas de permisos en dags/logs/plugins montados:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=

# Clave de cifrado de conexiones/variables. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=vrsY8ANHUDBoBjeMRM7jPSuYo5Hg1Elw6dNuZPHhOSc=

# Secreto de la API interna de tareas (execution API). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=d5b201d91ac5d8921f829217892e6f10ce59e86ce3547f98e1d2bbcbccae3b03

# Usuario administrador de la UI web
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Certificado raíz de un proxy TLS corporativo (p. ej. Zscaler). Dentro del
# contenedor de Airflow las descargas HTTPS fallan con CERTIFICATE_VERIFY_FAILED
# si el proxy reemplaza los certificados. Deja el .pem en config/certs/ (esa
# carpeta se monta en /opt/airflow/raillytics_config/certs/) y apunta aquí a la
# ruta DENTRO del contenedor; vacío = sin proxy.
#   AIRFLOW_CA_BUNDLE=/opt/airflow/raillytics_config/certs/ca-bundle.pem
AIRFLOW_CA_BUNDLE=

# === Superset — Dashboards sobre la capa Gold (docker-compose) ===
# Puerto de la UI web en el host (http://localhost:8088)
SUPERSET_PORT=8088
# Clave con la que Superset firma sesiones y cifra credenciales. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=JMo1I6cxT5M3SqH1Az4fmftWGqoUOO3RNY03j4DXPEuz63MrsWrVIjBk
# Usuario administrador de la UI web
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
