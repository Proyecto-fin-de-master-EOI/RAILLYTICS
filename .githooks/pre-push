#!/usr/bin/env bash
# Ejecuta los tests SBT antes de pushear, solo si el push incluye cambios en Scala/SBT.
set -euo pipefail

zero="0000000000000000000000000000000000000000"
has_scala_changes=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # borrado de rama remota

  if [ "$remote_sha" = "$zero" ]; then
    # Rama que todavia no existe en remoto: no hay sha con el que comparar, asi
    # que se miran los commits que no estan en ninguna rama remota.
    #
    # Aqui NO vale `git diff --name-only $local_sha`: eso compara el working tree
    # contra ese commit, no el contenido del commit. Con el arbol limpio devuelve
    # vacio, de modo que el primer push de una rama -justo cuando se abre la PR-
    # se saltaba los tests en silencio.
    cambiados=$(git log --name-only --pretty=format: "$local_sha" --not --remotes 2>/dev/null || true)
  else
    cambiados=$(git log --name-only --pretty=format: "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  if printf '%s\n' "$cambiados" | grep -qE '(^|/)([^/]+\.(scala|sbt)|project/.*)$'; then
    has_scala_changes=true
  fi
done

if [ "$has_scala_changes" = false ]; then
  exit 0
fi

if ! command -v sbt >/dev/null 2>&1; then
  echo "⚠ sbt no está en el PATH, se omite la comprobación de tests." >&2
  exit 0
fi

echo "→ Cambios en Scala/SBT detectados, ejecutando tests (sbt test)..."
if ! sbt -batch test; then
  echo "✗ sbt test ha fallado. Push abortado." >&2
  exit 1
fi
echo "✓ sbt test OK"
