#!/usr/bin/env bash
# Compila el proyecto SBT antes de commitear, solo si hay cambios en Scala/SBT staged.
set -euo pipefail

# Ojo: tambien cuenta config/data_sources.yml. El parser de Scala rechaza cualquier clave que no
# conozca, asi que anadir una clave al registro desde Python rompe L2 aunque no se toque ni una linea
# de Scala. Paso el 2026-10-13 con `obligatoria` y no lo vio nadie hasta correr la carga entera.
changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)([^/]+\.(scala|sbt)|project/.*|config/data_sources\.yml)$' || true)

if [ -z "$changed" ]; then
  exit 0
fi

if ! command -v sbt >/dev/null 2>&1; then
  echo "⚠ sbt no está en el PATH, se omite la comprobación de compilación." >&2
  exit 0
fi

echo "→ Cambios en Scala/SBT detectados, compilando (sbt compile)..."
if ! sbt -batch compile; then
  echo "✗ sbt compile ha fallado. Commit abortado." >&2
  exit 1
fi
echo "✓ sbt compile OK"
